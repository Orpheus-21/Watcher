#!/usr/bin/env bash
# List every git repo in ~/Work with its state. Enter opens lazygit in the repo.
export root=${PROJECTS_DIR:-$HOME/Work}

# watcher --herdr: list the Herdr workspaces instead. Enter focuses one.
if [ "${1:-}" = --herdr ]; then
  jq -rn --argjson w "$(herdr workspace list)" --argjson a "$(herdr agent list)" '
    def pad($n): (. + "                                        ")[:$n];
    ($a.result.agents | map({key: .workspace_id, value: .}) | from_entries) as $g
    | $w.result.workspaces[]
    | ($g[.workspace_id] // {}) as $x
    | [ ({"blocked":0,"done":1,"unknown":2,"working":3,"idle":4}[.agent_status] // 5),
        .workspace_id,
        ($x.pane_id // "-"),
        "\(.agent_status | pad(8)) \(.label | pad(34)) \($x.terminal_title_stripped // "")" ]
    | @tsv' | sort -s -t$'\t' -k1,1n |
    fzf --delimiter '\t' --with-nth 4 --no-sort --reverse \
        --header 'enter: focus workspace | order: blocked, done, unknown, working, idle' \
        --preview '[ {3} != - ] && herdr agent read {3} --source recent-unwrapped --lines 30' \
        --bind 'enter:execute-silent(herdr workspace focus {2})+abort'
  exit
fi

row() {
  local d=$1 ab
  ab=$(git -C "$d" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null | awk '{print "↓"$1" ↑"$2}')
  printf '%s\t%s\t%-22s %-12s %3s dirty  %-9s %s\n' \
    "$(git -C "$d" log -1 --format=%ct 2>/dev/null || echo 0)" \
    "$(basename "$d")" \
    "$(basename "$d")" \
    "$(git -C "$d" branch --show-current)" \
    "$(git -C "$d" status --porcelain | wc -l)" \
    "${ab:-no-remote}" \
    "$(git -C "$d" log -1 --format=%cr 2>/dev/null)"
}

for d in "$root"/*/; do
  [ -d "$d/.git" ] && row "${d%/}"
done | sort -rn |
  fzf --delimiter '\t' --with-nth 3 --no-sort --reverse \
      --header 'enter: lazygit | ctrl-t: terminal here | newest first' \
      --preview 'git -C "$root"/{2} status -sb; echo; git -C "$root"/{2} log --oneline -8' \
      --bind 'enter:execute(cd "$root"/{2} && lazygit)' \
      --bind 'ctrl-t:execute(cd "$root"/{2} && setsid xdg-terminal-exec >/dev/null 2>&1 &)'
